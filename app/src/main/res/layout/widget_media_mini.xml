<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/player_container_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_media_rect_bg" />

    <ImageView
        android:id="@+id/glass_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_media_glass_rect"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/glass_stroke"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_media_glass_stroke_rect"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/cover_parent"
        android:layout_width="92dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:padding="6dp">

        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_toEndOf="@id/cover_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/songName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/session_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_media_ripple"
                android:contentDescription="@string/widget_session_prev"
                android:scaleType="centerInside" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_media_ripple"
                android:contentDescription="@string/widget_previous"
                android:scaleType="centerInside" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <ImageButton
                    android:id="@+id/play_pause"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/widget_media_ripple"
                    android:contentDescription="@string/widget_play_pause"
                    android:scaleType="centerInside" />

                <ImageView
                    android:id="@+id/progress_round"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@null" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_media_ripple"
                android:contentDescription="@string/widget_next"
                android:scaleType="centerInside" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/session_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_media_ripple"
                android:contentDescription="@string/widget_session_next"
                android:scaleType="centerInside" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
